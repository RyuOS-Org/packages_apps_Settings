<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24.0dip"
    android:layout_marginVertical="32.0dip"
    android:paddingHorizontal="32.0dip"
    android:paddingVertical="24.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip"
        android:layout_marginEnd="18.0dip"
        android:src="@drawable/ryuos_logo"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/ryuos_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="RyuOS"
        android:textSize="36.0sp"
        android:textStyle="bold"
        android:textColor="@color/ryu_text_accent"
        android:letterSpacing="0.02" />

</LinearLayout>